<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/rounded_modal_bottom_sheet"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/invite_collaborators"
        android:textStyle="bold"
        android:textColor="@android:color/black"/>
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_collab_can"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collab_can"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/btn_close"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingTop="15dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingVertical="15dp"
        android:id="@+id/cl_edit_board_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_collab_can">
        <ImageView
            android:id="@+id/iv_edit_board_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_draw"
            android:padding="8dp"
            android:background="@drawable/gray_button_pinterest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_do_most"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="@string/do_most"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/iv_edit_board_permission"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_do_most_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="@string/do_most_caption"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/iv_edit_board_permission"
            app:layout_constraintEnd_toEndOf="@id/tv_do_most"
            app:layout_constraintTop_toBottomOf="@id/tv_do_most" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/tv_share_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_invite_link"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/cl_edit_board_permission"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingVertical="15dp"
        android:id="@+id/cl_copy_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_share_link">
        <ImageView
            android:id="@+id/iv_share_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_link"
            android:padding="8dp"
            android:background="@drawable/gray_button_pinterest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_copy_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="@string/copy_link"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/iv_share_link"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>