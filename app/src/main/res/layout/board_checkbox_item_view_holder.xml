<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkbox"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:buttonTint="@color/dark_grey"
        app:layout_constraintBottom_toBottomOf="@id/cv_board_image"
        app:layout_constraintEnd_toStartOf="@id/cv_board_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cv_board_image" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_board_image"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginStart="8dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/checkbox"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_board_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="@color/dark_grey"
            android:scaleType="centerCrop" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fixed_height"
            app:use_controller="false" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_board_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="@string/board_name_placeholder"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/cv_board_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_board_image"
        app:layout_constraintTop_toTopOf="@id/cv_board_image" />

</androidx.constraintlayout.widget.ConstraintLayout>