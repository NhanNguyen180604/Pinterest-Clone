<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remove_bg_navigation"
    app:startDestination="@id/removeBgFragment">

    <fragment
        android:id="@+id/removeBgFragment"
        android:name="com.example.pinterest_clone_test2.ui.pin.remove_bg.RemoveBgFragment"
        android:label="fragment_remove_bg"
        tools:layout="@layout/fragment_remove_bg">
        <action
            android:id="@+id/action_removeBgFragment_to_boardChoosingFragment"
            app:destination="@id/boardChoosingFragment"
            app:enterAnim="@anim/from_right"
            app:exitAnim="@anim/to_left"
            app:popEnterAnim="@anim/from_left"
            app:popExitAnim="@anim/to_right" />
    </fragment>
    <fragment
        android:id="@+id/boardChoosingFragment"
        android:name="com.example.pinterest_clone_test2.ui.board.board_choosing.BoardChoosingFragment"
        android:label="BoardChoosingFragment">
        <action
            android:id="@+id/action_boardChoosingFragment_to_createNewBoardFragment2"
            app:destination="@id/createNewBoardFragment2"
            app:enterAnim="@anim/from_right"
            app:exitAnim="@anim/to_left"
            app:popEnterAnim="@anim/from_left"
            app:popExitAnim="@anim/to_right" />
    </fragment>
    <fragment
        android:id="@+id/createNewBoardFragment2"
        android:name="com.example.pinterest_clone_test2.ui.board.CreateNewBoardFragment"
        android:label="CreateNewBoardFragment" />
</navigation>