<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_nav_pin_tab"
    app:startDestination="@id/managePinFragment">

    <fragment
        android:id="@+id/managePinFragment"
        android:name="com.example.pinterest_clone_test2.ui.admin.manage_pin.ManagePinFragment"
        android:label="fragment_manage_pin"
        tools:layout="@layout/fragment_manage_pin">
        <action
            android:id="@+id/action_managePinFragment_to_pinFragment"
            app:destination="@id/pinFragment"
            app:enterAnim="@anim/from_right"
            app:exitAnim="@anim/to_left"
            app:popEnterAnim="@anim/from_left"
            app:popExitAnim="@anim/to_right" />
        <action
            android:id="@+id/action_managePinFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment"
            app:enterAnim="@anim/from_right"
            app:exitAnim="@anim/to_left"
            app:popEnterAnim="@anim/from_left"
            app:popExitAnim="@anim/to_right" />
    </fragment>

    <fragment
        android:id="@+id/pinFragment"
        android:name="com.example.pinterest_clone_test2.ui.pin.PinFragment"
        android:label="fragment_pin"
        tools:layout="@layout/fragment_pin" />

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.pinterest_clone_test2.ui.user.UserProfileFragment"
        android:label="UserProfileFragment" />
</navigation>